# Copy to .env for local dev. Production values are injected via EAS
# (eas.json `build.production.env` or `eas env`), NOT committed here.

# Clerk — use a pk_test_ key locally, pk_live_ in EAS production env.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx

# Backend API. Local dev points at localhost; production must be the
# public https/wss origin (e.g. https://api.groupys.app/api).
EXPO_PUBLIC_API_URL=http://localhost:8080/api
EXPO_PUBLIC_WS_URL=ws://localhost:8080/api/ws/chat

# Google OAuth iOS reversed-client URL scheme (from GoogleService / Clerk).
EXPO_PUBLIC_CLERK_GOOGLE_IOS_URL_SCHEME=

# Apple Music feature flags. Keep the simulator mock OFF in production.
EXPO_PUBLIC_ENABLE_APPLE_MUSIC_CONNECT=true
EXPO_PUBLIC_ENABLE_APPLE_MUSIC_SIMULATOR_MOCK=true
