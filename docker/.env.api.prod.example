# API stack — consumed by docker-compose.api.prod.yaml (deploy-backend-prod.yml writes this as .env.api.prod)

# Image pushed by CI to GHCR
API_IMAGE=ghcr.io/your-org/groupys-api:latest

# Postgres (pgvector). POSTGRES_DB defaults to "db" if omitted.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=db

# MinIO — must NOT be "admin"; StartupConfigValidator rejects it in prod.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Clerk JWT validation — PRODUCTION Clerk instance uses the custom domain (clerk.<your-domain>),
# NOT the *.clerk.accounts.dev dev issuer. Tokens from a pk_live frontend are signed by this issuer.
JWT_ISSUER=https://clerk.groupys.app
JWT_PUBLIC_KEY_LOCATION=https://clerk.groupys.app/.well-known/jwks.json

# CORS — real frontend origin(s), comma-separated. No localhost (boot fails).
APP_CORS_ORIGINS=https://groupys.app

# Token encryption — freshly generated, NOT the dev fallback: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# Apple Music developer token signing
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_MEDIA_ID=

# Hot-takes / admin secret
GROUPYS_ADMIN_SECRET=
