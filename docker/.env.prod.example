# Web stack — consumed by docker-compose.web.prod.yaml (deploy-web-prod.yml writes this as .env.prod)

# Image pushed by CI to GHCR
WEB_IMAGE=ghcr.io/your-org/groupys-web:latest
# Host port bound to 127.0.0.1 (reverse proxy fronts it). Defaults to 3000.
WEB_PORT=3000

# Clerk auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Transactional email
RESEND_API_KEY=

# Analytics (optional)
NEXT_PUBLIC_GA_ID=

# Music providers (optional)
LASTFM_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
